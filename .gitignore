# Dependencies
node_modules/
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/

# Environment
.env
.env*.local
!.env.example

# Prisma generated client
packages/db/src/generated/
packages/db/prisma/generated/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Test output
coverage/

# Playwright
# Os relatórios e o estado de autenticação dos testes ponta a ponta são gerados
# em cada corrida e não pertencem ao repositório — incluem cookies de sessão de
# utilizadores de teste.
test-results/
playwright-report/
playwright/.cache/
e2e/.auth/
e2e/.results/
e2e/.results*/
e2e/.tmp/

# Capturas de evidência — ficam no disco, nunca no índice.
# O repositório é público e uma captura é o ecrã com os dados dessa máquina: a de `/cartoes`
# mostra «Cartão Millennium» e montantes (medido em relatorios/.qa-t73/depois.json). A prova
# que entra no git é a lista de SHA-256, bytes e dimensões de cada ficheiro — o primeiro
# exemplar é relatorios/EVIDENCIA-T73.md, e cada tarefa fechada passa a ter o seu. Para
# publicar uma captura *deliberadamente*: git add -f.
relatorios/**/*.png

# Rascunhos de QA (logs, capturas e JSON de trabalho; os relatórios é que são prova)
relatorios/.qa-*/
# artefactos de corridas e2e falhadas (traces, capturas) — ver T65
relatorios/.falhas/

*.tmp-*
