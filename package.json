{
  "name": "financas-pessoais",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "smoke": "node packages/db/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:push": "pnpm --filter @repo/db db:push",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:format": "pnpm --filter @repo/db db:format",
    "db:validate": "pnpm --filter @repo/db db:validate",
    "clean": "turbo run clean && rimraf node_modules .turbo"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
