# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Base de dados (Neon) ---------------------------------------------------
# Neon gives two connection strings for the same database:
#   * the POOLED one (host contains `-pooler`) -> DATABASE_URL, used at runtime
#   * the DIRECT one                            -> DIRECT_URL, used by migrations
# Migrations cannot run through a connection pooler.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/financas?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/financas?sslmode=require"

# For local development with `docker compose up -d` instead of Neon:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financas?schema=public"

# --- Autenticação (better-auth) --------------------------------------------
# Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-hex-string"
BETTER_AUTH_URL="http://localhost:3000"

# --- Tarefas agendadas ------------------------------------------------------
# Shared secret that authorises the Vercel Cron calls to the generation route.
CRON_SECRET="replace-me-with-a-random-string"

# --- Ambiente ---------------------------------------------------------------
# Node environment: development | test | production
NODE_ENV="development"
