# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# `.env` is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (`packages/db`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/financas?schema=public"

# Secret used by NextAuth to sign/encrypt tokens and cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-hex-string"

# Public base URL of the web app. NextAuth uses it to build callback URLs.
NEXTAUTH_URL="http://localhost:3000"

# Node environment: development | test | production
NODE_ENV="development"
